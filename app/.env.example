# ============================================================================
# Conector INMOGES–el portal de avisos UIF · ALMENA — variables de entorno
# Copia este archivo a .env y rellena los valores. NO subas .env al repo.
# ============================================================================

# ----------------------------------------------------------------------------
# el portal de avisos UIF (API PLD)
# ----------------------------------------------------------------------------
UIF_BASE=                               # url de la API el portal de avisos UIF
UIF_USER=                               # usuario de la API el portal de avisos UIF
UIF_PASS=                               # password de la API el portal de avisos UIF

# ----------------------------------------------------------------------------
# Snowflake (key-pair auth)
# ----------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=                           # ej: SNOWFLAKE_ACCOUNT
SNOWFLAKE_USER=                              # ej: SNOWFLAKE_USER
SNOWFLAKE_WAREHOUSE=                         # ej: SNOWFLAKE_WAREHOUSE
SNOWFLAKE_DATABASE=                          # ej: SNOWFLAKE_DATABASE
SNOWFLAKE_SCHEMA=                            # ej: SNOWFLAKE_SCHEMA
SNOWFLAKE_ROLE=                              # ej: SNOWFLAKE_ROLE
SNOWFLAKE_PRIVATE_KEY_PATH=/ruta/al/key_pk8.pem

# ----------------------------------------------------------------------------
# AWS Cognito — REQUERIDAS (autenticacion basica)
# ----------------------------------------------------------------------------
COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX     # Formato: region_ID
COGNITO_CLIENT_ID=                           # App Client ID (min 10 chars)
COGNITO_CLIENT_SECRET=                       # App Client Secret (min 10 chars)
AWS_REGION=us-east-2                         # Region del User Pool

# ----------------------------------------------------------------------------
# Cookies y Sesion — REQUERIDAS
# ----------------------------------------------------------------------------
# Generar la clave con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
COOKIE_ENCRYPTION_KEY=                       # Min 32 chars, compartida entre apps para SSO
COOKIE_DOMAIN=localhost                      # localhost (dev) o .tudominio.com (prod)
COOKIE_SECURE=false                          # false (dev/HTTP) o true (prod/HTTPS)
SESSION_TIMEOUT=3600                         # Segundos (default: 1 hora)
REFRESH_THRESHOLD=300                        # Segundos antes de expirar para refrescar

# ----------------------------------------------------------------------------
# Federation Microsoft Entra ID — OPCIONALES
# ----------------------------------------------------------------------------
ENABLE_FEDERATION=false                      # true para habilitar "Login con Microsoft"
COGNITO_DOMAIN=                              # Requerido si ENABLE_FEDERATION=true
SAML_PROVIDER_NAME=                          # Requerido si ENABLE_FEDERATION=true

# ----------------------------------------------------------------------------
# Toggle de autenticacion — OPCIONAL (solo dev!)
# ----------------------------------------------------------------------------
ENABLE_AUTH=true                             # false para desactivar auth completamente

# ----------------------------------------------------------------------------
# URL de esta app — para OAuth2 redirect (federation)
# ----------------------------------------------------------------------------
SITIO_UIF=http://localhost:8501         # URL publica de esta app
