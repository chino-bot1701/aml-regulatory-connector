# Copy to .env and fill in. NEVER commit .env — see .gitignore
# The public demo needs NONE of these: run it with `streamlit run demo/app_demo.py`.

# ---- Snowflake (key-pair auth, no password) ----
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=SVC_ANALYTICS
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_WAREHOUSE=WH_ANALYTICS
SNOWFLAKE_DATABASE=DB_ANALYTICS
SNOWFLAKE_SCHEMA=SCH_PLD
SNOWFLAKE_ROLE=ROLE_DASHBOARD

# ---- Source ERP REST API (ingestion scripts only) ----
ERP_API_BASE=
ERP_API_TOKEN=

# ---- Regulator portal (only used when actually submitting a report) ----
UIF_BASE=
UIF_USER=
UIF_PASS=

# ---- AWS Cognito (production sign-in; off in the demo) ----
ENABLE_AUTH=false
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
AWS_REGION=
COOKIE_DOMAIN=localhost

# ---- Container build ----
ECR_REGISTRY=
